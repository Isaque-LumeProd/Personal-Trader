# Banco de dados (SQLite por padrão; use postgresql+psycopg://... em produção)
DATABASE_URL=sqlite:///./personal_trader.db
# Troque por um valor aleatório longo em produção: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440
# Token da brapi.dev (https://brapi.dev/dashboard). Sem token o app roda em modo demo.
BRAPI_TOKEN=
# auto | brapi | demo
MARKET_DATA_PROVIDER=auto
# Período de histórico pedido à brapi (o plano gratuito aceita até 3mo)
HISTORY_RANGE=1y
CACHE_TTL_SECONDS=900
CORS_ORIGINS=["http://localhost:5173"]
