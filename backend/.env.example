# Banco de dados (SQLite por padrão; use postgresql+psycopg://... em produção)
DATABASE_URL=sqlite:///./personal_trader.db
# Troque por um valor aleatório longo em produção: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440
# Token da brapi.dev (https://brapi.dev/dashboard). Sem token o app roda em modo demo.
BRAPI_TOKEN=
# auto | brapi | demo
MARKET_DATA_PROVIDER=auto
# Período de histórico pedido à brapi (o plano gratuito aceita até 3mo)
HISTORY_RANGE=1y
CACHE_TTL_SECONDS=900
CORS_ORIGINS=["http://localhost:5173"]

# Migrações Alembic aplicadas automaticamente ao iniciar
AUTO_MIGRATE=true

# Alertas em segundo plano (0 desativa) e notificações
ALERT_CHECK_MINUTES=15
ALERT_MARKET_HOURS_ONLY=true
ALERT_COOLDOWN_HOURS=20
APP_URL=http://localhost:5173
# Telegram: crie um bot com o @BotFather e cole o token aqui
TELEGRAM_BOT_TOKEN=
# E-mail (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
